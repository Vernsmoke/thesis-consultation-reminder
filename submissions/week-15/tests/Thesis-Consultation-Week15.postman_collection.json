{
  "info": {
    "_postman_id": "98ac53a5-ae62-4c87-9b37-b4f41a2bb715",
    "name": "Thesis Consultation Reminder Week 15",
    "description": "Controlled IA6 collection. Supply the private fixture password only in a local Postman environment; do not export it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://localhost:8443/api" },
    { "key": "fixture_password", "value": "" },
    { "key": "student_token", "value": "" },
    { "key": "idempotency_key", "value": "week15_postman_fixture_001" },
    { "key": "consultation_id", "value": "" }
  ],
  "item": [
    {
      "name": "AUTH 01 Student login",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"student@example.test\",\"password\":\"{{fixture_password}}\"}" }, "url": "{{base_url}}/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('student_token', pm.response.json().token);"] } }]
    },
    {
      "name": "AUTH 02 Invalid credentials",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"student@example.test\",\"password\":\"controlled-wrong-value\"}" }, "url": "{{base_url}}/login" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"] } }]
    },
    {
      "name": "API 01 Unauthorized collection",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/consultations" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"] } }]
    },
    {
      "name": "API 02 Valid consultation",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }, { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"agenda\":\"Week 15 Postman controlled request\",\"scheduled_at\":\"2030-11-10T02:00:00Z\",\"adviser_id\":2,\"panel_id\":3}" }, "url": "{{base_url}}/consultations" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201 or replay 200', () => pm.expect([200,201]).to.include(pm.response.code));", "pm.collectionVariables.set('consultation_id', pm.response.json().id);"] } }]
    },
    {
      "name": "API 03 Duplicate replay",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }, { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"agenda\":\"Week 15 Postman controlled request\",\"scheduled_at\":\"2030-11-10T02:00:00Z\",\"adviser_id\":2,\"panel_id\":3}" }, "url": "{{base_url}}/consultations" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 replay', () => pm.response.to.have.status(200));", "pm.test('Replayed flag', () => pm.expect(pm.response.json().replayed).to.eql(true));"] } }]
    },
    {
      "name": "API 04 Invalid input",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }, { "key": "Idempotency-Key", "value": "week15_invalid_fixture" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"agenda\":\"bad\"}" }, "url": "{{base_url}}/consultations" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 422', () => pm.response.to.have.status(422));"] } }]
    },
    {
      "name": "API 05 Pagination boundary",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }], "url": "{{base_url}}/consultations?per_page=1" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('One record and metadata', () => { const body=pm.response.json(); pm.expect(body.data.length).to.eql(1); pm.expect(body.pagination.per_page).to.eql(1); });"] } }]
    },
    {
      "name": "API 06 Invalid page size",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }], "url": "{{base_url}}/consultations?per_page=0" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 422', () => pm.response.to.have.status(422));"] } }]
    },
    {
      "name": "API 07 Forbidden coordinator resource",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }], "url": "{{base_url}}/automation" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 403', () => pm.response.to.have.status(403));"] } }]
    },
    {
      "name": "API 08 Not found action",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{base_url}}/actions/999999/complete" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 404', () => pm.response.to.have.status(404));"] } }]
    }
  ]
}
