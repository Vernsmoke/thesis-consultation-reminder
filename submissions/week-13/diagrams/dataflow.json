          },
          {
            "id": "receipt",
            "label": "Simulated receipt minimal reference or summary counts"
          },
          {
            "id": "audit",
            "label": "Protected structured audit IDs only"
          },
          {
            "id": "human",
            "label": "Coordinator manual review"
          }
        ],
        "edges": [
          {
            "from": "browser",
            "to": "api",
            "label": "Bearer session and validated JSON"
          },
          {
            "from": "api",
